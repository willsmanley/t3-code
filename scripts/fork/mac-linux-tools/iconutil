#!/usr/bin/env python3
"""Linux stand-in for `iconutil -c icns <name>.iconset -o <file>.icns`.

Packs the iconset's PNGs into an .icns file (PNG-based entries, as iconutil writes them).
Only for building the macOS app on Linux (scripts/fork/mac-desktop-build-linux.sh).
"""
import os, struct, sys

TYPES = {
    "icon_16x16.png": b"icp4", "icon_16x16@2x.png": b"ic11",
    "icon_32x32.png": b"icp5", "icon_32x32@2x.png": b"ic12",
    "icon_128x128.png": b"ic07", "icon_128x128@2x.png": b"ic13",
    "icon_256x256.png": b"ic08", "icon_256x256@2x.png": b"ic14",
    "icon_512x512.png": b"ic09", "icon_512x512@2x.png": b"ic10",
}

args = sys.argv[1:]
if len(args) != 5 or args[0] != "-c" or args[1] != "icns" or args[3] != "-o":
    sys.exit(f"iconutil stand-in: unsupported arguments: {' '.join(args)}")
iconset, out = args[2], args[4]
chunks = []
for name, code in TYPES.items():
    path = os.path.join(iconset, name)
    if os.path.exists(path):
        data = open(path, "rb").read()
        if not data.startswith(b"\x89PNG"):
            sys.exit(f"iconutil stand-in: {path} is not a PNG")
        chunks.append(code + struct.pack(">I", len(data) + 8) + data)
if not chunks:
    sys.exit(f"iconutil stand-in: no icon PNGs in {iconset}")
body = b"".join(chunks)
with open(out, "wb") as f:
    f.write(b"icns" + struct.pack(">I", len(body) + 8) + body)
